---
import '~/assets/styles/global.css';

import Favicons from '~/components/head/Favicons.astro';
import Metadata, { type Props as MetadataProps } from '~/components/head/Metadata.astro';
import SalonSchema from '~/components/head/SalonSchema.astro';
import { SITE } from '~/data/site';

export interface Props {
  metadata?: MetadataProps;
  /** The salon page sits on the night of the drawing, the other pages on caramel. */
  tone?: 'night' | 'ground';
}

const { metadata = {}, tone = 'ground' } = Astro.props;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#2a1d16" />
    <Metadata {...metadata} />
    <Favicons />
    <SalonSchema />
  </head>

  <body class:list={['overflow-x-hidden', tone === 'night' ? 'bg-night' : 'bg-ground-3']}>
    <slot />
  </body>
</html>
