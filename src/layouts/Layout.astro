---
import '~/assets/styles/global.css';

import Favicons from '~/components/head/Favicons.astro';
import Metadata, { type Props as MetadataProps } from '~/components/head/Metadata.astro';
import SalonSchema from '~/components/head/SalonSchema.astro';
import { SITE } from '~/data/site';

export interface Props {
  metadata?: MetadataProps;
}

const { metadata = {} } = Astro.props;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Metadata {...metadata} />
    <Favicons />
    <SalonSchema />
  </head>

  <body class="bg-ground-3 font-body text-ink antialiased">
    <slot />
  </body>
</html>
