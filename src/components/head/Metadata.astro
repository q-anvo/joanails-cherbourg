---
import { SITE } from '~/data/site';

export interface Props {
  title?: string;
  useTitleTemplate?: boolean;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  useTitleTemplate = true,
  description = SITE.description,
  image = SITE.image,
  noindex = false,
} = Astro.props;

const fullTitle = !title ? SITE.name : useTitleTemplate ? SITE.titleTemplate.replace('%s', title) : title;
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary" />

<meta name="google-site-verification" content={SITE.googleSiteVerification} />
