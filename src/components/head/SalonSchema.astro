---
import { SITE } from '~/data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'NailSalon',
  name: SITE.name,
  image: new URL(SITE.image, SITE.url).href,
  priceRange: '€€',
  telephone: '+33749394404',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '73 rue du Val de Saire',
    addressLocality: 'Cherbourg-en-Cotentin',
    postalCode: '50100',
    addressCountry: 'FR',
  },
  url: SITE.url,
  openingHours: ['Mo-Fr 09:00-18:00', 'Sa 09:00-17:00'],
  sameAs: [
    'https://www.instagram.com/joanails.cherbourg/',
    'https://www.fresha.com/fr/a/joanails-cherbourg-cherbourg-en-cotentin-cherbourg-en-cotentin-73-rue-du-val-de-saire-wk17zc9v',
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
