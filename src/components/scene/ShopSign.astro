---
import { Image } from 'astro:assets';

import logo from '~/assets/images/logo.webp';
---

<div class="sign">
  <Image src={logo} alt="Joa Nails" width={420} loading="eager" />
  <p>Un cocon de détente, tout près du centre-ville de Cherbourg.</p>
</div>

<style>
  .sign {
    position: absolute;
    z-index: 3;
    top: calc(env(safe-area-inset-top, 0px) + 3.5svh);
    left: 50%;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 10px;
    width: min(88%, 340px);
    text-align: center;
    pointer-events: none;
    animation: sign-in 1.6s 0.8s var(--ease-salon) both;
  }

  .sign img {
    width: clamp(150px, 44vw, 210px);
    height: auto;
    filter: invert(1) sepia(0.6) saturate(2) hue-rotate(300deg) brightness(1.5)
      drop-shadow(0 0 8px rgb(255 200 210 / 0.9)) drop-shadow(0 0 18px rgb(220 140 150 / 0.6))
      drop-shadow(0 2px 4px rgb(30 10 5 / 0.6));
    animation: neon 6s 2.4s ease-in-out infinite;
  }

  .sign p {
    margin: 0;
    color: rgb(255 245 225 / 0.94);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    font-weight: 500;
    line-height: 1.45;
    text-shadow:
      0 1px 12px rgb(10 5 0 / 0.9),
      0 2px 6px rgb(0 0 0 / 0.6);
  }

  @keyframes sign-in {
    from {
      opacity: 0;
    }
  }

  @keyframes neon {
    0%,
    100% {
      opacity: 0.94;
    }
    50% {
      opacity: 1;
    }
    51% {
      opacity: 0.86;
    }
    52% {
      opacity: 1;
    }
  }

  @media (max-width: 1023.98px) {
    .sign {
      top: calc(env(safe-area-inset-top, 0px) + 16px);
      gap: 6px;
    }

    .sign img {
      width: 112px;
    }

    .sign p {
      max-width: 30ch;
      font-size: 1.05rem;
    }
  }

  @media (min-width: 1024px) {
    .sign {
      top: 4svh;
      width: min(80%, 290px);
    }

    .sign img {
      width: clamp(170px, 14vw, 230px);
    }
  }
</style>
