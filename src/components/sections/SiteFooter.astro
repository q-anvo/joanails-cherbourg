---
import { SALON } from '~/data/salon';
---

<footer>
  <div class="wrap">
    <span>{SALON.name} · {SALON.address.city}</span>
    <nav aria-label="Informations légales">
      <a href="/mentions">Mentions légales</a>
      <a href="/privacy">Confidentialité</a>
    </nav>
    <span>Made with love by <a href="https://q-anvo.github.io/" target="_blank" rel="noopener">Q.A</a></span>
  </div>
</footer>

<style>
  footer {
    padding-block: 48px calc(96px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-line);
  }

  .wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    font-size: var(--step--1);
    color: var(--color-ink-soft);
  }

  nav {
    display: flex;
    gap: 18px;
  }

  a {
    text-underline-offset: 4px;
  }

  a:hover {
    color: var(--color-rose);
  }

  @media (min-width: 1024px) {
    footer {
      padding-bottom: 40px;
    }
  }
</style>
