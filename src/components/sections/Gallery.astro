---
import posts from '~/assets/instagram.json';
import SectionHead from '~/components/ui/SectionHead.astro';
import { SALON } from '~/data/salon';
import { excerpt, latestPosts, postAlt, postDate } from '~/lib/instagram';

const GALLERY_SIZE = 9;
const latest = latestPosts(posts, GALLERY_SIZE);
---

<section class="page-section gallery" id="galerie">
  <div class="wrap">
    <div class="top">
      <SectionHead eyebrow="Galerie" class="head">
        <Fragment slot="title">Les <em>dernières</em> poses.</Fragment>
        Tout droit du fil Instagram du salon.
        <a class="handle" href={SALON.instagram.url} target="_blank" rel="noopener">{SALON.instagram.handle}</a>
      </SectionHead>
      <div class="arrows">
        <button type="button" data-gallery-step="-1" aria-label="Poses précédentes">←</button>
        <button type="button" data-gallery-step="1" aria-label="Poses suivantes">→</button>
      </div>
    </div>
    <ul class="track" data-gallery-track>
      {
        latest.map((post) => {
          const text = excerpt(post.caption);
          return (
            <li>
              <a class="post" href={post.permalink} target="_blank" rel="noopener">
                <figure>
                  <img
                    src={post.thumbnail}
                    alt={postAlt(post)}
                    width="320"
                    height="320"
                    loading="lazy"
                    decoding="async"
                  />
                  {post.video && <span class="play" aria-hidden="true" />}
                </figure>
                <time datetime={post.timestamp}>{postDate(post.timestamp)}</time>
                {text && <p>{text}</p>}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  import '~/scripts/gallery';
</script>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(24px, 4cqi, 40px);
  }

  .top :global(.head) {
    min-width: 0;
    margin-bottom: 0;
  }

  .handle {
    display: inline-block;
    overflow-wrap: anywhere;
    font: 1.15rem var(--font-display);
    color: var(--color-rose-2);
    text-underline-offset: 5px;
  }

  .arrows {
    display: flex;
    gap: 8px;
  }

  .arrows button {
    width: 46px;
    height: 46px;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    background: none;
    color: var(--color-ink);
    font: 400 1.2rem / 1 var(--font-body);
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s;
  }

  .arrows button:hover {
    background: var(--color-ink);
    color: var(--color-ground);
  }

  .track {
    display: grid;
    grid-auto-columns: clamp(210px, 64cqi, 290px);
    grid-auto-flow: column;
    gap: 16px;
    margin: 0;
    padding: 0 0 6px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .post {
    display: grid;
    gap: 10px;
    text-decoration: none;
    scroll-snap-align: start;
  }

  figure {
    position: relative;
    margin: 0;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 20px;
    background: var(--color-ground-2);
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-salon);
  }

  .post:hover img {
    transform: scale(1.05);
  }

  .play {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgb(42 29 22 / 0.7);
  }

  .play::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0;
    height: 0;
    translate: 2px 0;
    border-block: 7px solid transparent;
    border-left: 11px solid #fff;
  }

  time {
    font: 400 0.72rem / 1 var(--font-mono);
    color: var(--color-caramel);
  }

  .post p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--color-ink-soft);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
</style>
