---
import posts from '~/assets/instagram.json';
import GalleryCard from '~/components/gallery/GalleryCard.astro';
import PillTabs from '~/components/ui/PillTabs.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import { PORTFOLIO } from '~/data/portfolio';
import { SALON } from '~/data/salon';
import { excerpt, latestPosts, postAlt, postDate } from '~/lib/instagram';

const INSTAGRAM_SIZE = 9;
const latest = latestPosts(posts, INSTAGRAM_SIZE);
const tabs = [
  { panel: 'gallery-portfolio', label: 'Les poses' },
  { panel: 'gallery-instagram', label: 'Sur Instagram' },
];
---

<section class="page-section gallery" id="galerie">
  <div class="wrap">
    <SectionHead eyebrow="Galerie" class="head">
      <Fragment slot="title">Les <em>dernières</em> poses.</Fragment>
      Le portfolio de Joséphine, et le fil Instagram du salon.
      <a class="handle" href={SALON.instagram.url} target="_blank" rel="noopener">{SALON.instagram.handle}</a>
    </SectionHead>
    <div class="bar">
      <PillTabs tabs={tabs} label="Galerie" name="gallery" />
      <div class="arrows">
        <button type="button" data-gallery-step="-1" aria-label="Poses précédentes">←</button>
        <button type="button" data-gallery-step="1" aria-label="Poses suivantes">→</button>
      </div>
    </div>
    <ul class="track on" id="gallery-portfolio" role="tabpanel" aria-labelledby="tab-gallery-portfolio">
      {PORTFOLIO.map((photo) => <GalleryCard image={photo.src} alt={photo.alt} shape="portrait" />)}
    </ul>
    <ul class="track" id="gallery-instagram" role="tabpanel" aria-labelledby="tab-gallery-instagram">
      {
        latest.map((post) => (
          <GalleryCard
            image={post.thumbnail}
            alt={postAlt(post)}
            href={post.permalink}
            video={post.video}
            date={{ iso: post.timestamp, label: postDate(post.timestamp) }}
            caption={excerpt(post.caption)}
            shape="square"
          />
        ))
      }
    </ul>
  </div>
</section>

<script>
  import '~/scripts/gallery';
</script>

<style>
  .handle {
    display: inline-block;
    overflow-wrap: anywhere;
    font: 1.15rem var(--font-display);
    color: var(--color-rose-2);
    text-underline-offset: 5px;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(20px, 3cqi, 32px);
  }

  .bar :global([data-tabs]) {
    min-width: 0;
    margin-inline: 0;
    padding-inline: 0;
  }

  .arrows {
    display: flex;
    flex: none;
    gap: 8px;
  }

  .arrows button {
    width: 46px;
    height: 46px;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    background: none;
    color: var(--color-ink);
    font: 400 1.2rem / 1 var(--font-body);
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s;
  }

  .arrows button:hover {
    background: var(--color-ink);
    color: var(--color-ground);
  }

  .track {
    display: grid;
    grid-auto-columns: clamp(210px, 64cqi, 290px);
    grid-auto-flow: column;
    align-items: start;
    gap: 16px;
    margin: 0;
    padding: 0 0 6px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .track:not(.on) {
    display: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  @container (max-width: 479.98px) {
    .arrows {
      display: none;
    }
  }
</style>
