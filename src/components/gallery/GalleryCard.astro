---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  /** A processed asset, or a ready-made thumbnail under public/. */
  image: ImageMetadata | string;
  alt: string;
  href?: string;
  video?: boolean;
  date?: { iso: string; label: string };
  caption?: string;
  shape: 'square' | 'portrait';
}

const { image, alt, href, video, date, caption, shape } = Astro.props;
const Frame = href ? 'a' : 'div';
const link = href ? { href, target: '_blank', rel: 'noopener' } : {};
---

<li>
  <Frame class="card" {...link}>
    <figure class={shape}>
      {
        typeof image === 'string' ? (
          <img src={image} alt={alt} width="320" height="320" loading="lazy" decoding="async" />
        ) : (
          <Image src={image} alt={alt} width={580} quality={80} loading="lazy" decoding="async" />
        )
      }
      {video && <span class="play" aria-hidden="true" />}
    </figure>
    {date && <time datetime={date.iso}>{date.label}</time>}
    {caption && <p>{caption}</p>}
  </Frame>
</li>

<style>
  .card {
    display: grid;
    gap: 10px;
    text-decoration: none;
    scroll-snap-align: start;
  }

  figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 20px;
    background: var(--color-ground-2);
  }

  .square {
    aspect-ratio: 1;
  }

  .portrait {
    aspect-ratio: 4 / 5;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-salon);
  }

  a.card:hover img {
    transform: scale(1.05);
  }

  .play {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgb(42 29 22 / 0.7);
  }

  .play::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0;
    height: 0;
    translate: 2px 0;
    border-block: 7px solid transparent;
    border-left: 11px solid #fff;
  }

  time {
    font: 400 0.72rem / 1 var(--font-mono);
    color: var(--color-caramel);
  }

  p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--color-ink-soft);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
</style>
