---
export interface Props {
  eyebrow: string;
  class?: string;
}

const { eyebrow, class: className } = Astro.props;
---

<div class:list={['section-head rise', className]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="display"><slot name="title" /></h2>
  {
    Astro.slots.has('default') && (
      <p class="lede">
        <slot />
      </p>
    )
  }
</div>

<style>
  .section-head {
    display: grid;
    gap: 16px;
    max-width: 700px;
    margin-bottom: clamp(32px, 5cqi, 56px);
  }

  h2 {
    font-size: var(--step-4);
    letter-spacing: -0.01em;
  }

  .lede {
    max-width: 54ch;
    margin: 0;
    color: var(--color-ink-soft);
  }
</style>
