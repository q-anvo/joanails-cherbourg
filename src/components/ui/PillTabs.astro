---
export interface Props {
  /** Each tab names the id of the panel it shows; the first one starts selected. */
  tabs: { panel: string; label: string }[];
  label: string;
  /** A badge per tab, filled by showTabCounts(). */
  counts?: boolean;
  /** Hook for the parent's styles and scripts. */
  name: string;
}

const { tabs, label, counts = false, name } = Astro.props;
---

<div class="tabs" role="tablist" aria-label={label} data-tabs={name}>
  {
    tabs.map(({ panel, label }, index) => (
      <button
        type="button"
        role="tab"
        id={`tab-${panel}`}
        aria-controls={panel}
        aria-selected={index === 0 ? 'true' : 'false'}
      >
        {label}
        {counts && <b data-tab-count hidden />}
      </button>
    ))
  }
</div>

<style>
  .tabs {
    display: flex;
    gap: 8px;
    margin-inline: calc(-1 * var(--gutter));
    padding: 2px var(--gutter) 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  button {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 8px;
    padding: 11px 17px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-ground-2);
    color: var(--color-ink);
    font: 400 1.02rem / 1 var(--font-display);
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s;
  }

  button[aria-selected='true'] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-ground);
  }

  b {
    display: grid;
    place-items: center;
    min-width: 19px;
    height: 19px;
    padding-inline: 5px;
    border-radius: 999px;
    background: var(--color-rose-2);
    color: #fff;
    font: 500 0.68rem / 1 var(--font-mono);
  }

  b[hidden] {
    display: none;
  }
</style>
