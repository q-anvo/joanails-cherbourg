---
import { SALON } from '~/data/salon';
---

<div class="map">
  <iframe
    src={SALON.maps.embed}
    title="Le salon Joanails sur Google Maps"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen></iframe>
</div>
<a class="text-button" href={SALON.maps.directions} target="_blank" rel="noopener">Itinéraire</a>

<style>
  .map {
    width: 100%;
    max-width: 260px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 18px;
    background: var(--color-ground-2);
    box-shadow: 0 18px 36px -16px rgb(0 0 0 / 0.5);
  }

  iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: sepia(0.35) saturate(0.8);
  }
</style>
