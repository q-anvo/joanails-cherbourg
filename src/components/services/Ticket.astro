---
import { SALON } from '~/data/salon';
---

<aside class="ticket" aria-label="Votre pose">
  <header>
    <b>{SALON.brand}</b><small>{SALON.address.street} · Cherbourg</small>
  </header>
  <ul class="picked" data-ticket-lines aria-live="polite">
    <li class="empty" data-ticket-empty>Touchez une prestation pour l’ajouter.</li>
  </ul>
  <div class="total"><span>Total</span><output data-ticket-total>0€</output></div>
  <div class="length"><span>Durée</span><span data-ticket-length>–</span></div>
  <p class="handoff" data-ticket-handoff hidden></p>
  <p class="note">Prix indicatif, confirmé au salon. Paillettes et strass estimés pour dix ongles.</p>
  <div class="phone">
    <b>{SALON.phone.display}</b><button type="button" data-copy-phone={SALON.phone.display}>Copier</button>
  </div>
  <a class="book" data-compose href={SALON.fresha.booking} target="_blank" rel="noopener">Réserver sur Fresha</a>
</aside>

<style>
  .ticket {
    position: sticky;
    top: calc(env(safe-area-inset-top, 0px) + 24px);
    display: grid;
    gap: 14px;
    padding: 26px 22px 30px;
    background: var(--color-paper);
    color: var(--color-ink);
    font: 400 0.86rem / 1.5 var(--font-mono);
    rotate: 0.6deg;
    filter: drop-shadow(0 18px 30px rgb(0 0 0 / 0.45));
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 14px 100%;
  }

  header {
    display: grid;
    gap: 2px;
    padding-bottom: 12px;
    border-bottom: 1px dashed currentColor;
    text-align: center;
  }

  header b {
    font: 400 1.6rem / 1 var(--font-display);
    letter-spacing: 0.04em;
  }

  header small {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .picked {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .picked :global(li) {
    display: grid;
    grid-template-rows: 1fr;
    transition:
      grid-template-rows 0.35s var(--ease-salon),
      opacity 0.35s,
      margin 0.35s var(--ease-salon);
  }

  .picked :global(li > div) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    min-height: 0;
    overflow: hidden;
  }

  .picked :global(li span:last-child) {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @starting-style {
    .picked :global(li) {
      grid-template-rows: 0fr;
      opacity: 0;
    }
  }

  .picked :global(li.out) {
    grid-template-rows: 0fr;
    margin-top: -6px;
    opacity: 0;
    text-decoration: line-through;
  }

  .picked .empty {
    opacity: 0.65;
  }

  .picked .empty[hidden] {
    display: none;
  }

  .total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px dashed currentColor;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  output {
    font-size: 1.9rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  output :global(small) {
    margin-right: 4px;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .length {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: -8px;
    font-size: 0.78rem;
    opacity: 0.8;
  }

  .handoff {
    margin: 0;
    padding: 10px 12px;
    border-radius: 10px;
    background: color-mix(in oklab, var(--color-rose-2) 13%, transparent);
    font-size: 0.76rem;
  }

  .handoff[hidden] {
    display: none;
  }

  .note {
    margin: 0;
    font-size: 0.72rem;
    opacity: 0.7;
  }

  .phone {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .phone b {
    font-weight: 500;
    user-select: all;
  }

  .phone button {
    padding: 6px 10px;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .book {
    padding: 12px 18px;
    border-radius: 10px;
    background: var(--color-ink);
    color: var(--color-paper);
    font: 400 1.08rem / 1.2 var(--font-display);
    text-align: center;
    text-decoration: none;
    transition: background 0.3s;
  }

  .book:hover {
    background: var(--color-rose);
  }
</style>
