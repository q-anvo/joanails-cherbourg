---
import { duration, priceLabel } from '~/lib/format';
import type { Service } from '~/lib/menu';

export interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<button class="row" type="button" aria-pressed="false" data-service={service.id}>
  <span class="tick" aria-hidden="true"></span>
  <span>{service.name}<small>{duration(service.minutes)}</small></span>
  <span class="price">{priceLabel(service)}</span>
</button>

<style>
  .row {
    display: grid;
    grid-template-columns: 20px 1fr auto;
    align-items: baseline;
    gap: 14px;
    width: 100%;
    padding: 14px 4px;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background 0.4s,
      padding 0.4s var(--ease-salon);
  }

  /* touch screens keep :hover after a tap, which would shift the row */
  @media (hover: hover) {
    .row:hover {
      padding-left: 12px;
      background: color-mix(in oklab, var(--color-rose-2) 14%, transparent);
    }
  }

  .row:active {
    background: color-mix(in oklab, var(--color-rose-2) 14%, transparent);
  }

  .tick {
    align-self: center;
    width: 14px;
    height: 20px;
    border: 1px solid var(--color-ink-soft);
    border-radius: 50% 50% 44% 44% / 62% 62% 38% 38%;
    transition:
      background 0.3s,
      border-color 0.3s,
      transform 0.4s var(--ease-salon);
  }

  .row[aria-pressed='true'] .tick {
    border-color: var(--color-rose-2);
    background: var(--color-rose-2);
    transform: rotate(-12deg);
  }

  small {
    display: block;
    margin-top: 2px;
    font: 400 0.72rem / 1.3 var(--font-mono);
    color: var(--color-ink-soft);
  }

  .price {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-caramel);
  }
</style>
