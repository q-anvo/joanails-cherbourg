    <img src="/images/logo.png" alt="Joanails" class="mx-auto w-40" />
    <h1 class="font-display text-5xl text-rose-2 md:text-6xl">Oups… un ongle cassé.</h1>
    <p class="text-lg">On répare ça ! 💅</p>
    <a href="/" class="mx-auto rounded-full bg-rose px-6 py-3 text-paper transition hover:bg-rose-2">
      Revenir à nos ongles parfaits
    </a>
  </main>
</Layout>
