---
import SalonScene from '~/components/scene/SalonScene.astro';
import BeforeYouCome from '~/components/sections/BeforeYouCome.astro';
import Gallery from '~/components/sections/Gallery.astro';
import Reviews from '~/components/sections/Reviews.astro';
import Salon from '~/components/sections/Salon.astro';
import Services from '~/components/sections/Services.astro';
import SiteFooter from '~/components/sections/SiteFooter.astro';
import Welcome from '~/components/sections/Welcome.astro';
import BookButton from '~/components/ui/BookButton.astro';
import Layout from '~/layouts/Layout.astro';

const metadata = {
  title: 'Joanails - Salon de manucure à Cherbourg | Onglerie, Gel & Nail Art',
  description:
    'Joanails, salon de manucure à Cherbourg-en-Cotentin : pose de gel, vernis semi-permanent, nail art, soins des mains et pieds. Composez votre pose et réservez sur Fresha.',
  useTitleTemplate: false,
};
---

<Layout metadata={metadata} tone="night">
  <SalonScene />
  <BookButton />

  <main>
    <div class="window" aria-hidden="true"></div>
    <div class="sheet">
      <Welcome />
      <Gallery />
      <Reviews />
      <Services />
      <BeforeYouCome />
      <Salon />
      <SiteFooter />
    </div>
  </main>
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
    pointer-events: none;
    container-type: inline-size;
  }

  main > * {
    pointer-events: auto;
  }

  main > .window {
    height: min(calc(var(--band) + 133.34vw - 34px), 92svh);
    pointer-events: none;
  }

  .sheet {
    isolation: isolate;
    transform: translateZ(0);
    overflow: clip;
    border-radius: 30px 30px 0 0;
    background: var(--color-ground);
    box-shadow: 0 -24px 60px rgb(0 0 0 / 0.45);
  }

  @media (min-width: 1024px) {
    main {
      min-height: 100vh;
      margin-left: var(--split);
      background: var(--color-ground);
    }

    .window {
      display: none;
    }

    .sheet {
      border-radius: 0;
      box-shadow: none;
    }
  }
</style>
